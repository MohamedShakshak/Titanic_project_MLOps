FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_SYSTEM_PYTHON=1 \
    PORT=8000 \
    MODEL_PATH=models/logistic_pipeline.pkl

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY uv.lock pyproject.toml ./
RUN uv sync --frozen --no-dev --group inference --no-install-project

ENV PATH="/app/.venv/bin:$PATH"

# Copy source code
COPY src/__init__.py ./src/__init__.py
COPY src/training/__init__.py ./src/training/__init__.py
COPY src/training/features/ ./src/training/features/
COPY src/training/pipeline.py ./src/training/pipeline.py
COPY src/deployment/online ./src/deployment/online
COPY server.py ./server.py


# Copy model file directly into the image
# The model is baked in — changing it requires rebuilding the image
COPY models/ ./models/

RUN useradd --create-home --shell /bin/bash --uid 1001 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE ${PORT}

HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=30s \
    --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

CMD ["python", "server.py"]